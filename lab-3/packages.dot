digraph G {
    rankdir="LR"
    ratio=auto
    ranksep=auto
    splines=true

    label="Huffman Encoding Dependency Structure"
    labelloc="t"

    // Nodes
    subgraph cluster_main {
        label="main"
        style=rounded
        style=filled
        pencolor="#AEB6BE"
        bgcolor="#E5F5FD"
        lab3 [label="lab3"]
        main [label="__main__.py"]
        lab3_init [label="__init__.py"]
        huffman [label="huffman"]

        lab3 -> lab3_init
        main -> lab3
        lab3 -> huffman
    }

    subgraph cluster_huffman {
        label="huffman"
        style=rounded
        style=filled
        pencolor="#AEB6BE"
        bgcolor="#EBF3E7"
        codec [label="codec.py"]
        errors [label="errors.py"]
    }

    subgraph cluster_encoding {
        label="encoding"
        style=rounded
        style=filled
        pencolor="#AEB6BE"
        bgcolor="#EBF3E7"
        encode [label="encode.py"]
        decode [label="decode.py"]
        normalize [label="normalize.py"]
        tree [label="tree.py"]
        encode -> normalize
    }
    
    subgraph cluster_tree {
        label="tree.py"
        style=rounded
        style=filled
        pencolor="#AEB6BE"
        bgcolor="#ECE8F6"
        Tree [label="Tree" shape=rectangle]
        preorder [label="preorder"]
        postorder [label="postorder"]
        inorder [label="inorder"]
        data [label="data"]
        left_child [label="left_child"]
        right_child [label="right_child"]
        Tree -> {
            data
            left_child
            right_child
            preorder
            postorder
            inorder
        }
        length [label="length"]
        parent_index [label="parent_index(index)"]
        left_child_index [label="left_child_index(index)"]
        right_child_index [label="right_child_index(index)"]
        enqueue [label="enqueue(item)"]
        dequeue [label="dequeue"]
        peek [label="peek"]
        is_empty [label="is_empty"]
        MinHeap [label="MinHeap" shape=rectangle]
        MinHeap -> {
            right_child_index
            left_child_index
            length
            parent_index
            enqueue
            dequeue
            peek
            is_empty
        }
    }

    huffman -> codec
    huffman -> errors

    codec -> encode
    codec -> decode
    codec -> normalize

    encode -> MinHeap
    decode -> MinHeap
    
    encode -> Tree
    decode -> Tree

}