digraph G {
    rankdir="LR"
    ratio=auto
    ranksep=auto
    splines=true

    label="Huffman Encoding Dependency Structure"
    labelloc="t"

    // Nodes
    subgraph cluster_main {
        label="main"
        style=rounded
        style=filled
        pencolor="#AEB6BE"
        bgcolor="#E5F5FD"
        lab3 [label="lab3"]
        main [label="__main__.py"]
        lab3_init [label="__init__.py"]
        huffman [label="huffman"]

        lab3 -> lab3_init
        main -> lab3
        lab3 -> huffman
    }

    subgraph cluster_huffman {
        label="huffman"
        style=rounded
        style=filled
        pencolor="#AEB6BE"
        bgcolor="#EBF3E7"
        codec [label="codec.py"]
        errors [label="errors.py"]
    }

    subgraph cluster_encoding {
        label="encoding"
        style=rounded
        style=filled
        pencolor="#AEB6BE"
        bgcolor="#EBF3E7"
        encode [label="encode.py"]
        decode [label="decode.py"]
        prioritize [label="prioritize.py"]
        normalize [label="normalize.py"]
        tree [label="tree.py"]
        encode -> normalize
        encode -> prioritize
    }
    
    subgraph cluster_tree {
        label="tree"
        style=rounded
        style=filled
        pencolor="#AEB6BE"
        bgcolor="#EBF3E7"
        Tree [label="Tree" shape=rectangle]
        build [label="build"]
        preorder [label="preorder"]
        data [label="data"]
        left_child [label="left_child"]
        right_child [label="right_child"]
        Tree -> {
            data
            left_child
            right_child
        }
        build -> Tree
        preorder -> Tree
    }

    huffman -> codec
    huffman -> errors

    codec -> encode
    codec -> decode
    codec -> prioritize
    codec -> normalize

    encode -> tree
    decode -> tree
    
    tree -> preorder
    tree -> build

}